# Cloud provider credentials (set only for providers used by the config).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: placeholder or credential for configured local/remote vLLM endpoints.
VLLM_API_KEY=

# Local loopback MLX configs do not require an API key variable.

# Optional legacy single-backend defaults. Named-backend YAML normally overrides these.
OPENAI_API_BASE=
DEFAULT_LLM_MODEL=
AGENT_MODEL=
PARSER_MODEL=
